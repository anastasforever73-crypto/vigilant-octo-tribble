{
  "name": "mart-trade-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/write-build-info.cjs && next build --webpack",
    "start": "next start",
    "start:codespaces": "PORT=3100 next start --hostname 0.0.0.0 --port 3100",
    "lint": "eslint .",
    "test": "node tests/core.test.cjs && node tests/user-access.test.cjs && node tests/receivables.test.cjs && node tests/receivables-script.test.cjs && node tests/opiu.test.cjs && node tests/planning.test.cjs && node tests/wallet-percentage.test.cjs && node tests/period-balances.test.cjs && node tests/fintablo-period-balances.test.cjs && node tests/backup.test.cjs",
    "setup-auth": "node scripts/setup-auth.mjs",
    "storage:check": "node scripts/storage.cjs check",
    "storage:migrate": "node scripts/storage.cjs migrate",
    "storage:verify": "node scripts/storage.cjs verify",
    "archive:migrate": "node scripts/storage.cjs archive-migrate",
    "test:archive": "node tests/period-archive.test.cjs",
    "test:excel": "node tests/excel-export.test.cjs",
    "test:timeweb": "node tests/timeweb-compat.test.cjs && node tests/timeweb-preflight.test.cjs && node --test tests/timeweb-recovery.test.cjs",
    "migration:check": "node scripts/timeweb-preflight.cjs",
    "recovery:export": "node scripts/timeweb-recovery.cjs export",
    "recovery:plan": "node scripts/timeweb-recovery.cjs plan",
    "recovery:import": "node scripts/timeweb-recovery.cjs import",
    "storage:tls-check": "node scripts/postgres-check.cjs",
    "test:postgres": "node --test tests/postgres.test.cjs",
    "test:postgres:wire": "node --test tests/postgres-wire.test.cjs",
    "test:google-dashboard": "node tests/google-dashboard.test.cjs",
    "test:backup": "node tests/backup.test.cjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "exceljs": "4.4.0",
    "googleapis": "^160.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "pg": "8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
