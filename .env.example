# Required server-only auth settings. Generate secrets locally; never commit real values.
# AUTH_SECRET: random secret of at least 32 characters.
AUTH_SECRET=
# Administrator: chosen login and scrypt hash of a four-digit PIN.
# Generate the hash with: node scripts/hash-password.mjs (hidden terminal input).
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
# Optional legacy viewer account (set both or leave both empty).
USER_LOGIN=
USER_PASSWORD_HASH=
# Optional individual viewers; all entries get the user role, never admin.
# Schema only (no real credentials): [{"login":"<chosen-login>","passwordHash":"<salted-scrypt-hash>","enabled":true,"sections":["overview","cash"],"revision":"<generated-version>"}]
# Store in Vercel as encrypted, production-only (not NEXT_PUBLIC_).
DASHBOARD_USERS_JSON=[]
# Optional live user management via the Vercel API. The registry variable must
# be type encrypted, not sensitive, because its salted hashes must be readable by the server.
# Store the dedicated API token as Sensitive. Never use a browser/public token.
DASHBOARD_USERS_VERCEL_TOKEN=
DASHBOARD_USERS_PROJECT_ID=
DASHBOARD_USERS_TEAM_ID=
DASHBOARD_USERS_ENV_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_RANGES=
DEBT_TRANSIT_SHEET=Транзит
DEBT_STOCK_SHEET=Склад
DEBT_GOOGLE_SHEET_ID=
FINTABLO_API_BASE_URL=
FINTABLO_API_URL=
FINTABLO_API_TOKEN=
GOOGLE_SHEETS_ENABLED=
FINTABLO_ENABLED=
DEBT_ENABLED=
CASH_SHEET=
ORDERS_SHEET=
DEBTOR_SHEET=
FACTORY_SHEET=
WALLET_SHEET=
ACCOUNT_SHEET=
DEBT_SHEET=
# Persistent source connections (standard PostgreSQL TCP). Apply all migrations/001-008 to a NEW database only.
DATABASE_URL=
# Separate 32-byte key encoded as 64 hexadecimal characters; never reuse AUTH_SECRET.
CONNECTIONS_ENCRYPTION_KEY=

# Exact public HTTPS origin behind the Timeweb reverse proxy; no trailing slash.
APP_ORIGIN=

# PostgreSQL TLS: always verify certificate and hostname for remote databases.
DATABASE_SSL_MODE=verify-full
# CA PEM from Timeweb (use this OR DATABASE_SSL_CA_FILE, not both).
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
# Optional private IP transport while validating the certificate DNS name.
DATABASE_HOSTADDR=
DATABASE_TLS_SERVERNAME=
DATABASE_POOL_MAX=5
